# Debian Trixie base and first-boot/runtime services.
ca-certificates
debian-archive-keyring
cloud-guest-utils
dbus
e2fsprogs
locales
kbd
# login owns /bin/login and the PAM stack behind it (/etc/pam.d/login).  Debian
# moved it out of the base system into a package of its own, and nothing this
# manifest installs depends on it: the serial console reaches agetty and then
# has no program to hand the terminal to, so the board boots to a login prompt
# that never appears and cannot be logged into.  Naming it here is what keeps
# that from being something the first boot of a board has to discover.
login
network-manager
openssh-server
parted
polkitd
pkexec
sudo
systemd
systemd-sysv
systemd-timesyncd
tzdata
udev
whiptail
zram-tools

# Filesystems, networking and hardware access.
dosfstools
exfatprogs
fuse3
iproute2
nftables
cifs-utils
ntfs-3g
smbclient
podman
slirp4netns
uidmap
fuse-overlayfs
initramfs-tools
usbutils
wireguard-tools

# Audio and Bluetooth plumbing.
alsa-utils
bluez
pipewire
pipewire-pulse
pulseaudio-utils
wireplumber
