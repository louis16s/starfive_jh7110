                "都应该是离线也能完成的。更新失败也不会影响已经做好的设置。",
                "oobe-hint",
            ),
            False,
            False,
            0,
        )
        return box

    # ----------------------------------------------------------- page: hardware
    def page_hardware(self):
        box = self.page_box(
            "硬件检测", "检测结果只保存在本机（/var/lib/jh7110/hardware.json），不会上传。"
        )
        controls = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        self.hardware_status = self.text_label("正在检测…", "oobe-hint")
        controls.pack_start(self.hardware_status, True, True, 0)
        again = Gtk.Button(label="重新检测")
        again.connect("clicked", lambda _button: self.start_hardware_check())
        controls.pack_start(again, False, False, 0)
        box.pack_start(controls, False, False, 0)

        self.hardware_grid = Gtk.Grid(column_spacing=16, row_spacing=6)
        box.pack_start(self.hardware_grid, False, False, 0)
        box.pack_start(
            self.text_label(
                "“可用”表示硬件和驱动都在，“未检测”多半只是没有接设备。检测不会阻塞设置。",
                "oobe-hint",
            ),
            False,
            False,
            0,
        )
        return box

    def start_hardware_check(self):
        self.hardware_status.set_text("正在检测…")
        self.in_background(oobe.hardware_report, self.hardware_ready)

    def hardware_ready(self, report, error):
        if error:
            log("the hardware check failed: %s" % error)
            self.hardware_status.set_text("检测失败：%s（不影响继续设置）" % error)
            return
        for child in self.hardware_grid.get_children():
            self.hardware_grid.remove(child)
        for index, item in enumerate(report.get("checks", [])):
            name = Gtk.Label(label=item["name"], xalign=0)
            name.get_style_context().add_class("oobe-text")
            self.hardware_grid.attach(name, 0, index, 1, 1)
            detail = Gtk.Label(label=item["detail"], xalign=0)
            detail.get_style_context().add_class("oobe-hint")
            detail.set_ellipsize(Pango.EllipsizeMode.END)
            self.hardware_grid.attach(detail, 1, index, 1, 1)
            style = ""
            if item["status"] in ("ok", "available"):
                style = "ok"
            elif item["status"] in ("error", "unsupported"):
                style = "bad"
            elif item["status"] in ("not-detected", "not-verified"):
                style = "warn"
            self.hardware_grid.attach(
                self.badge(oobe.STATUS_LABELS.get(item["status"], item["status"]), style),
                2,
                index,
                1,
                1,
            )
        self.hardware_grid.show_all()
        self.session.hardware = report
        summary = report.get("summary", {})
        self.hardware_status.set_text(
            "检测完成：正常 %d、可用 %d、未检测 %d"
            % (
                summary.get("ok", 0),
                summary.get("available", 0),
                summary.get("not-detected", 0),
            )
        )

    # ------------------------------------------------------------ page: confirm
    def page_confirm(self):
        box = self.page_box("确认设置", "点击“开始设置”后，向导会依次应用下面的内容。")
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        card.get_style_context().add_class("oobe-card")
        self.confirm_grid = Gtk.Grid(column_spacing=16, row_spacing=6)
        card.pack_start(self.confirm_grid, False, False, 0)
        box.pack_start(card, False, False, 0)
        box.pack_start(
            self.text_label(
                "密码不会出现在这里，也不会写入任何文件：它在创建账户时直接交给系统，"
                "之后系统只保存密码的哈希。",
                "oobe-hint",
            ),
            False,
            False,
            0,
        )
        return box

    def shown_confirm(self):
        for child in self.confirm_grid.get_children():
            self.confirm_grid.remove(child)
        session = self.session
        rows = [
            ("设备名称", session.hostname),
            ("用户名", session.username),
            ("显示名称", session.display_name or session.username),
            ("语言和区域", "%s（%s）" % (oobe.locale_label(session.locale), session.locale)),
            ("时区", session.timezone),
            ("键盘布局", session.keymap),
            ("SSH", "开启" if session.ssh_enabled else "关闭"),
            ("网络", "已连接" if session.network_configured else "未连接（可以稍后配置）"),
        ]
        for index, (label, value) in enumerate(rows):
            name = Gtk.Label(label=label, xalign=0)
            name.get_style_context().add_class("oobe-hint")
            self.confirm_grid.attach(name, 0, index, 1, 1)
            detail = Gtk.Label(label=value, xalign=0)
            detail.get_style_context().add_class("oobe-text")
            self.confirm_grid.attach(detail, 1, index, 1, 1)
        self.confirm_grid.show_all()
        self.next_button.set_label("开始设置")

    # ------------------------------------------------------------- page: finish
    def page_finish(self):
        box = self.page_box("正在完成设置…", "请不要断电。")
        self.finish_label = self.text_label("正在应用设置…")
        box.pack_start(self.finish_label, False, False, 0)
        self.progress = Gtk.ProgressBar()
        self.progress.set_pulse_step(0.05)
        box.pack_start(self.progress, False, False, 0)
        self.finish_detail = self.text_label("", "oobe-hint")
        box.pack_start(self.finish_detail, False, False, 0)
        return box

    def shown_finish(self):
        self.finish_started = False
        self.finish_done = False
        self.next_button.set_label("完成")
        self.next_button.set_sensitive(False)
        # The page is shown before the work starts, so the progress bar is on
        # screen by the time the first step runs.
        GLib.idle_add(self.start_finalize)

    def start_finalize(self):
        """Apply everything from this page.  This is also what "重试" does.

        Every method the backend offers is idempotent, so running the sequence
        again after a failure repairs what is there rather than building a
        second one.
        """
        if self.finish_started:
            return False
        self.finish_started = True
        self.finish_done = False
        self.finish_label.set_text("正在应用设置…")
        self.finish_detail.set_text("")
        self.progress.set_fraction(0.0)
        self.back_button.set_visible(False)
        password = self.password_entry.get_text()
        self.set_busy(True, "正在应用设置…")
        self.progress.pulse()
        self.pulse_timer = GLib.timeout_add(120, self.pulse)
        session = self.session

        def work():
            return session.apply_all(password)

        self.in_background(work, self.finalize_done)
        return False

    def pulse(self):
        if self.busy:
            self.progress.pulse()
            return True
        self.pulse_timer = None
        return False

    def finalize_done(self, result, error):
        self.set_busy(False)
        if self.pulse_timer is not None:
            GLib.source_remove(self.pulse_timer)
            self.pulse_timer = None
        if error:
            log("the setup stopped: %s" % error)
            self.finish_problem("设置没有完成", "%s\n点击“重试”可以继续。" % error, error)
            return
        success, failed_step, message = result
        if not success:
            log("the setup stopped at: %s" % failed_step)
            self.finish_problem(
                "“%s”这一步没有完成" % failed_step,
                "%s\n已经应用的设置不会丢失，点击“重试”可以继续。" % message,
                message,
            )
            return
        self.progress.set_fraction(1.0)
        self.finish_done = True
        # The password is not needed any more, and the field should not keep it
        # on screen while the machine waits at the login prompt.
        self.password_entry.set_text("")
        self.confirm_entry.set_text("")
        oobe.clear_attempts()
        self.finish_label.set_text("设置完成")
        self.finish_detail.set_text(
            "现在可以用账户 %s 和刚刚设置的密码登录桌面了。" % self.session.username
        )
        self.set_status("设置完成", "oobe-good")
        self.next_button.set_label("完成")
        self.next_button.set_sensitive(True)
        self.next_button.grab_focus()
        log("the setup finished for user %s" % self.session.username)

    def finish_problem(self, title, detail, message):
        self.finish_done = False
        self.finish_label.set_text(title)
        self.finish_detail.set_text(detail)
        self.set_status("设置失败：%s" % message, "oobe-error")
        self.next_button.set_label("重试")
        self.next_button.set_sensitive(True)
        self.back_button.set_visible(True)
        self.finish_started = False


if __name__ == "__main__":
    sys.exit(main())
