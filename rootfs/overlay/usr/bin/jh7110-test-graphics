#!/usr/bin/env bash
set -Eeuo pipefail

# Run from a terminal in the logged-in desktop, preserving DISPLAY/XAUTHORITY.
export LC_ALL=C
failures=0
warnings=0

printf 'GPU kernel modules:\n'
loaded_modules=0
for module in pvrsrvkm pvr; do
    if [[ -d "/sys/module/$module" ]]; then
        printf '  LOADED %s\n' "$module"
        loaded_modules=1
    fi
done
if ((loaded_modules == 0)); then
    module_dir="/lib/modules/$(uname -r)"
    if [[ -d "$module_dir" ]] && find "$module_dir" -type f \
        \( -iname '*pvrsrvkm*.ko*' -o -iname '*pvr*.ko*'  \) \
        -print -quit | grep -q .; then
        printf 'FAIL GPU: PVR module exists but is not loaded\n'
        failures=$((failures + 1))
    else
        printf 'FAIL GPU: no PVR kernel module loaded or installed\n'
        failures=$((failures + 1))
    fi
fi

printf 'GPU firmware and userspace:\n'
firmware_count=0
for firmware in /lib/firmware/rgx.fw.36.50.54.182 /lib/firmware/rgx.sh.36.50.54.182; do
    if [[ -s "$firmware" ]]; then
        printf '  FOUND %s\n' "$firmware"
        firmware_count=$((firmware_count + 1))
    fi
done
if ((firmware_count != 2)); then
    printf 'FAIL GPU: IMG BXE firmware is missing\n'
    failures=$((failures + 1))
fi
if [[ -e /usr/lib/libVK_IMG.so || -e /usr/lib/libVK_IMG.so.1 ]]; then
    printf '  FOUND /usr/lib/libVK_IMG.so\n'
else
    printf 'FAIL GPU: IMG Vulkan ICD library is missing\n'
    failures=$((failures + 1))
fi

printf 'Kernel DRM messages:\n'
if dmesg_output=$(dmesg 2>&1); then
    { grep -iE 'pvr|pvrsrvkm|gpu|drm|starfive' <<<"$dmesg_output" || true; } | tail -80
else
    printf 'WARN GPU: dmesg is restricted for this user\n'
    warnings=$((warnings + 1))
fi
probe() {
    local label=$1
    shift
    # The Vulkan probe is invoked as `env VAR=value ... vulkaninfo`, so the
    # command whose presence matters is the first argument that is neither an
    # assignment nor the env wrapper.  Checking `env` instead would report a
    # missing vulkaninfo as a failing GPU.
    local command_name= argument
    for argument in "$@"; do
        case "$argument" in
            *=*) continue ;;
            env) continue ;;
            *) command_name=$argument; break ;;
        esac
    done
    if [[ -z "$command_name" ]] || ! command -v "$command_name" >/dev/null 2>&1; then
        printf 'FAIL %s: 未安装 %s\n' "$label" "${command_name:-<command>}"
        failures=$((failures + 1))
        return
    fi
    local result
    if result=$(timeout 30 "$@" 2>&1); then
        printf '%s\n' "$result"
        case "$label" in
            # Vulkan 是这块板子上唯一的硬件加速证据：IMG ICD 只选择厂商
            # 驱动，所以软件渲染器在这里就是 GPU 不工作。
            Vulkan)
                if grep -Eiq 'llvmpipe|softpipe|lavapipe|software rasterizer' <<<"$result"; then
                    printf 'FAIL %s: 发现软件渲染器，不能确认硬件加速通过\n' "$label"
                    failures=$((failures + 1))
                elif ! grep -Eiq 'powervr|img[ -]?bxe|rogue|img technologies' <<<"$result"; then
                    printf 'FAIL %s: 没有 PowerVR renderer/device 证据\n' "$label"
                    failures=$((failures + 1))
                else
                    printf 'PASS %s: 发现 PowerVR 设备\n' "$label"
                fi
                ;;
            # X11 走 modesetting 且镜像默认 AccelMethod=none
            # （/etc/X11/xorg.conf.d/20-jh7110-safe-desktop.conf），所以 GLX 与
            # EGL 报软件渲染是设计结果，不是 GPU 故障：既不能报 PASS，也不该
            # 让整份诊断返回失败。硬件加速由上面的 Vulkan 结果负责证明。
            OpenGL|EGL)
                if grep -Eiq 'llvmpipe|softpipe|lavapipe|software rasterizer' <<<"$result"; then
                    printf 'WARN %s: 软件渲染是 X11/modesetting 的默认路径，不算 GPU 加速；请以 Vulkan 结果为准\n' "$label"
                    warnings=$((warnings + 1))
                elif ! grep -Eiq 'powervr|img[ -]?bxe|rogue|img technologies' <<<"$result"; then
                    printf 'FAIL %s: 没有 PowerVR renderer/device 证据\n' "$label"
                    failures=$((failures + 1))
                else
                    printf 'PASS %s: 发现 PowerVR 设备\n' "$label"
                fi
                ;;
        esac
    else
        printf 'FAIL %s: 命令失败或超时\n%s\n' "$label" "$result"
        failures=$((failures + 1))
    fi
}

printf 'JH7110 图形诊断\nKernel: %s\nSession: %s\n' "$(uname -r)" "${XDG_SESSION_TYPE:-unknown}"
shopt -s nullglob
nodes=(/dev/dri/card* /dev/dri/renderD*)
if ((${#nodes[@]})); then
    ls -l "${nodes[@]}"
else
    printf 'FAIL: 无 DRM 设备\n'
    failures=$((failures + 1))
fi
connected=0
for connector in /sys/class/drm/card*-HDMI-A-*; do
    if [[ -r "$connector/status" && $(<"$connector/status") == connected ]]; then
        connected=$((connected + 1))
        if [[ ! -r "$connector/modes" || ! -r "$connector/enabled" ]] ||
            [[ -z $(<"$connector/modes") || $(<"$connector/enabled") != enabled ]]; then
            printf 'FAIL HDMI: 已连接但没有模式或未启用\n'
            failures=$((failures + 1))
        fi
    fi
    printf '\nHDMI: %s\n' "${connector##*/}"
    for field in status enabled modes; do
        if [[ -r "$connector/$field" ]]; then
            printf '%s:\n' "$field"
            cat "$connector/$field"
        fi
    done
done
if ((connected == 0)); then
    printf 'FAIL HDMI: 没有已连接的 HDMI 输出\n'
    failures=$((failures + 1))
fi
probe DRM drm_info
# Isolate the IMG ICD: enumeration of a CPU fallback must not hide GPU failure.
if [[ -s /etc/vulkan/icd.d/icdconf.json ]]; then
    probe Vulkan env VK_DRIVER_FILES=/etc/vulkan/icd.d/icdconf.json \
        VK_ICD_FILENAMES=/etc/vulkan/icd.d/icdconf.json vulkaninfo --summary
else
    printf 'FAIL Vulkan: IMG ICD manifest is missing\n'
    failures=$((failures + 1))
fi
if [[ -n "${DISPLAY:-}" ]]; then
    probe OpenGL glxinfo -B
    probe Display xrandr --current
else
    # 没有 DISPLAY（例如串口或 SSH 会话）时这项检查无从执行。它不是硬件
    # 能力缺失，报成失败会让整份诊断在没有桌面会话时恒定返回非零。
    printf 'WARN: 未设置 DISPLAY，跳过 X11 检测；请在桌面终端重新运行\n'
    warnings=$((warnings + 1))
fi
if [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
    probe EGL eglinfo -B
fi
if command -v glmark2-x11 >/dev/null 2>&1 && [[ -n "${DISPLAY:-}" ]]; then
    printf '提示：可手动运行 glmark2-x11 或 glmark2-wayland 进行基准测试。\n'
fi
printf '\n诊断失败计数: %s，警告计数: %s（命令成功不等于实板验收通过）\n' \
    "$failures" "$warnings"
((failures == 0))
