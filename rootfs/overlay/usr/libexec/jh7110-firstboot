#!/usr/bin/env bash
set -Eeuo pipefail

readonly STATE_DIR=/var/lib/jh7110
readonly BOARD_CONFIG=/etc/jh7110/board.conf

die() {
    echo "jh7110-firstboot: $*" >&2
    exit 1
}

[[ $(id -u) -eq 0 ]] || die "must run as root"
[[ -r "$BOARD_CONFIG" ]] || die "missing $BOARD_CONFIG"
# shellcheck source=/dev/null
source "$BOARD_CONFIG"

install -d -m 0755 "$STATE_DIR"

setup_root_password() {
    local password confirmation state
    # Linux VT fonts cannot render the desktop's CJK fonts. Use readable
    # console text; the installed desktop keeps its Chinese locale.
    local LC_ALL=C
    export LC_ALL TERM=linux

    [[ "${DEFAULT_USER:-root}" == root ]] || die "only root default user is supported"
    state=$(passwd -S root | awk '{print $2}')
    case "$state" in
        P)
            return
            ;;
        L|LK|NP)
            ;;
        *)
            die "cannot determine root password state: $state"
            ;;
    esac

    chvt 1 || die "cannot activate setup console tty1"

    command -v whiptail >/dev/null 2>&1 \
        || die "whiptail is required for first-boot password setup"

    while :; do
        password=$(whiptail \
            --title "JH7110 first boot" \
            --passwordbox "Set the root password (at least 8 characters):" \
            10 72 3>&1 1>&2 2>&3) || die "password setup cancelled"
        confirmation=$(whiptail \
            --title "JH7110 first boot" \
            --passwordbox "Confirm the root password:" \
            10 72 3>&1 1>&2 2>&3) || die "password confirmation cancelled"

        # The console locale is C so the Linux VT font can render the dialog,
        # and under C ${#password} counts bytes: a three-character CJK password
        # would satisfy an eight-character minimum.  Count characters instead.
        password_length=$(printf '%s' "$password" | LC_ALL=C.UTF-8 wc -m)
        if (( password_length < 8 )); then
            whiptail --title "Password too short" \
                --msgbox "Use at least 8 characters." 8 60
            continue
        fi
        if [[ "$password" != "$confirmation" ]]; then
            whiptail --title "Passwords differ" \
                --msgbox "Please enter matching passwords." 8 60
            continue
        fi
        # chpasswd writes a hash, which already clears the locked state the
        # image ships with; a separate `passwd --unlock` would only add a way
        # for this step to fail after the password has been accepted.
        if ! printf 'root:%s\n' "$password" | chpasswd; then
            unset password confirmation
            die "failed to set root password"
        fi
        unset password confirmation
        echo "Password configured. Starting the desktop."
        break
    done
}

# Prompt for the root password before anything else that can fail.  The image
# is built with a locked root account, so every later step in this script - an
# invalid timezone in board.conf, a partition table that cannot be grown - is a
# step that would otherwise strand the user on a login prompt with no usable
# account.  setup_root_password returns immediately once a password is set, so
# re-running this service after a later failure does not ask twice.
setup_root_password

if [[ -n "${BOARD_ID:-}" && "$BOARD_ID" != unconfigured ]]; then
    hostnamectl set-hostname "jh7110-$BOARD_ID"
else
    die "invalid board configuration"
fi

timezone_name=${TIMEZONE:-}
[[ -n "$timezone_name" && -f "/usr/share/zoneinfo/$timezone_name" ]] \
    || die "invalid timezone: ${TIMEZONE:-unset}"
ln -sfn "/usr/share/zoneinfo/$timezone_name" /etc/localtime
printf '%s\n' "$timezone_name" > /etc/timezone

if [[ ! -s /etc/machine-id ]]; then
    systemd-machine-id-setup
fi

ssh-keygen -A

if command -v locale-gen >/dev/null 2>&1; then
    locale-gen en_US.UTF-8 zh_CN.UTF-8
fi
if command -v update-locale >/dev/null 2>&1; then
    update-locale LANG="${DEFAULT_LOCALE:-zh_CN.UTF-8}" \
        LANGUAGE="${DEFAULT_LANGUAGE:-zh_CN:zh:en_US:en}" \
        LC_MESSAGES="${DEFAULT_LOCALE:-zh_CN.UTF-8}"
fi

root_source=$(findmnt --noheadings --output SOURCE /)
if [[ -b "$root_source" ]] && command -v growpart >/dev/null 2>&1; then
    parent_device=$(lsblk --noheadings --output PKNAME "$root_source" | awk 'NF { print "/dev/" $1; exit }')
    partition_number=$(lsblk --noheadings --output PARTN "$root_source" | awk 'NF { print; exit }')
    if [[ -n "$parent_device" && -n "$partition_number" ]]; then
        if growpart "$parent_device" "$partition_number"; then
            :
        else
            growpart_status=$?
            [[ "$growpart_status" -eq 1 ]] || die "growpart failed with status $growpart_status"
        fi
    fi
fi
[[ -b "$root_source" ]] || die "root is not a block device: $root_source"
[[ $(findmnt --noheadings --output FSTYPE /) == ext4 ]] || die "expected ext4 root"
# e2fsprogs is explicitly installed; do not rely on systemd's optional growfs helper.
# Failing here leaves the root password already set, so the failure stays
# recoverable: log in on the console and run this service again.
resize2fs "$root_source" || die "could not grow the root filesystem"

# The hardware report is diagnostic, and this script runs under `set -e`.
# jh7110-info itself never fails on a missing attribute, but the redirect can
# still fail (a full or read-only state directory), and losing the report must
# not cost the user the rest of first boot.
if command -v jh7110-info >/dev/null 2>&1; then
    jh7110-info > "$STATE_DIR/hardware-report.firstboot.txt" \
        || echo "jh7110-firstboot: could not write the hardware report" >&2
fi

touch "$STATE_DIR/firstboot.done"
systemctl disable jh7110-firstboot.service
