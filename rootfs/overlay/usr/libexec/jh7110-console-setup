#!/usr/bin/env bash
# Interactive first-run setup on the console, for the boards the desktop cannot
# reach.
#
# The normal first-run path is the graphical setup in the greeter session.  This
# is the one that works when that cannot run at all - no display, no GTK, a board
# reached over the serial console - or when the user asks for it:
#
#     sudo systemctl start jh7110-console-setup     # on tty9
#     sudo jh7110-console-setup                     # on the console you are on
#
# It asks for the desktop account and the password that protects it, and for the
# device name; everything a machine can do by itself lives in jh7110-prepare,
# which this runs first when it has not run yet.
#
# The image ships with root locked and no human account at all, which is why
# this has to exist and why it must stay reachable.
#
# Remove /var/lib/jh7110/oobe.done to let the graphical setup run again; that is
# what `sudo jh7110-oobe --reset` does.
set -Eeuo pipefail

readonly STATE_DIR=/var/lib/jh7110
readonly BOARD_CONFIG=/etc/jh7110/board.conf
readonly DONE_FILE="$STATE_DIR/oobe.done"
readonly ACCOUNT_TOOL=/usr/libexec/jh7110-account

# The console the setup is meant to appear on.  tty1 belongs to the desktop -
# LightDM and the wizard run there - so the recovery console is tty9.
readonly SETUP_TTY=9

die() {
    echo "jh7110-console-setup: $*" >&2
    exit 1
}

[[ $(id -u) -eq 0 ]] || die "must run as root"
[[ -r "$BOARD_CONFIG" ]] || die "missing $BOARD_CONFIG"
# shellcheck source=/dev/null
source "$BOARD_CONFIG"
# shellcheck source=/dev/null
source /usr/lib/jh7110/common.sh

install -d -m 0755 "$STATE_DIR"

# The machine may be half-prepared: this may be the only thing that ever runs
# on a board whose boot failed before the prepare unit finished.  A failure
# here is reported and does not stop the account from being created - a user
# who can log in is what makes the board recoverable - and prepare.done stays
# absent, so the next boot tries the machine half again.
if [[ ! -e "$STATE_DIR/prepare.done" && -x /usr/libexec/jh7110-prepare ]]; then
    /usr/libexec/jh7110-prepare \
        || jh7110_log "machine preparation failed; continuing with the account setup"
fi

# The console locale is C so the Linux VT font can render the dialogs: the
# desktop's CJK fonts do not exist in a text console.
export LC_ALL=C TERM=linux

[[ -x "$ACCOUNT_TOOL" ]] || die "missing $ACCOUNT_TOOL"
command -v whiptail >/dev/null 2>&1 || die "whiptail is required for the console setup"

ask() { # $1 title, $2 prompt, $3 default
    whiptail --title "$1" --inputbox "$2" 10 64 "${3:-}" 3>&1 1>&2 2>&3
}

complain() { # $1 title, $2 message
    whiptail --title "$1" --msgbox "$2" 10 64
}

# A password typed twice, measured in characters rather than bytes: under the C
# console locale ${#password} counts bytes, and a three-character CJK password
# would pass an eight-character minimum.  The value is only ever handed to
# chpasswd over a pipe by jh7110-account; it is not written down anywhere.
ask_password() { # $1 user name
    local password confirmation length
    while :; do
        password=$(whiptail --title "Set the password for $1" \
            --passwordbox "Password for $1 (at least 8 characters):" \
            10 64 3>&1 1>&2 2>&3) || die "password setup cancelled"
        confirmation=$(whiptail --title "Set the password for $1" \
            --passwordbox "Repeat the password:" \
            10 64 3>&1 1>&2 2>&3) || die "password confirmation cancelled"

        length=$(printf '%s' "$password" | LC_ALL=C.UTF-8 wc -m)
        if (( length < 8 )); then
            complain "Password too short" "Use at least 8 characters."
            continue
        fi
        if [[ "$password" != "$confirmation" ]]; then
            complain "Passwords differ" "Please enter matching passwords."
            continue
        fi
        break
    done
    unset confirmation
    printf '%s' "$password"
}

ask_user_name() {
    local name
    while :; do
        name=$(ask "Desktop account" \
            "User name for the desktop (the account that uses sudo):" \
            "${DEFAULT_USER:-jh7110}") || die "user name prompt cancelled"
        if "$ACCOUNT_TOOL" validate "$name" 2>/dev/null; then
            break
        fi
        complain "User name not accepted" \
            "Use lower-case letters, digits, '_' and '-', starting with a letter or '_'. The name 'root' cannot be used."
    done
    printf '%s' "$name"
}

ask_hostname() {
    local name
    while :; do
        name=$(ask "Device name" "Hostname for this board:" \
            "$(jh7110_default_hostname)") || die "hostname prompt cancelled"
        if jh7110_hostname_validate "$name" 2>/dev/null; then
            break
        fi
        complain "Device name not accepted" \
            "Use letters, digits and '-', at most 63 characters."
    done
    printf '%s' "$name"
}

# An account that can use sudo is what this step is for; one already there
# means the setup has been through this board, and asking again would only be
# a way to lock the user out of their own files.
existing_account() {
    local members
    getent group sudo >/dev/null 2>&1 || return 1
    members=$(getent group sudo | cut -d: -f4)
    [[ -n "$members" ]] || return 1
    printf '%s' "${members%%,*}"
}

setup_desktop_account() {
    local password user_name
    if user_name=$(existing_account); then
        echo "Account $user_name already exists; nothing to create."
        return 0
    fi

    # The prompts need a console in front of somebody.  Under systemd this runs
    # on tty9 and is brought to the front; started by hand from the serial
    # console there is no VT to switch to, and the dialogs simply appear where
    # the command was run.
    if ! chvt "$SETUP_TTY" 2>/dev/null; then
        echo "jh7110-console-setup: no virtual console to switch to; staying on this terminal"
    fi

    user_name=$(ask_user_name)
    password=$(ask_password "$user_name")

    # The account tool is the one implementation of this: it validates again,
    # adds only the groups this system actually has, and verifies what it
    # created.  The password goes in over a pipe, never as an argument.
    if ! printf '%s\n' "$password" | "$ACCOUNT_TOOL" create "$user_name"; then
        unset password
        die "could not create the desktop account $user_name"
    fi
    unset password

    echo "Desktop account $user_name created."
}

setup_desktop_account

# The name is written by the machine half as well, but a board that never got
# that far still has to answer to something a person can type, and the console
# is where the user is asked about it.
device_name=$(ask_hostname)
jh7110_set_system_hostname "$device_name" \
    || die "could not set the system hostname to $device_name"
unset device_name

# Written last: the board now has an account and a name, so the next boot can
# go straight to the greeter.
: > "$DONE_FILE"
echo "Setup complete. Starting the desktop."
